local function getNearestTarget()

	if not character then return nil end

	local screenCenter = Vector2.new(
		camera.ViewportSize.X/2,
		camera.ViewportSize.Y/2
	)

	local closest = nil
	local shortest = math.huge

	for _,model in pairs(workspace:GetDescendants()) do

		if model:IsA("Model") and model ~= character then

			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local hrp = model:FindFirstChild("HumanoidRootPart")

			if humanoid and hrp and humanoid.Health > 0 then

				local pos, visible = camera:WorldToViewportPoint(hrp.Position)

				if visible then

					local screenPos = Vector2.new(pos.X,pos.Y)
					local dist = (screenPos - screenCenter).Magnitude

					if dist < shortest then
						shortest = dist
						closest = model
					end

				end
			end
		end
	end

	return closest

end

lockButton.MouseButton1Click:Connect(function()

	lockEnabled = not lockEnabled

	if lockEnabled then
		lockedTarget = getNearestTarget()
		lockButton.Text = "UNLOCK"
	else
		lockedTarget = nil
		lockButton.Text = "LOCK"
	end

end)

-------------------------------------------------
-- SISTEMA LOCK
-------------------------------------------------

RunService.RenderStepped:Connect(function()

	if not lockEnabled then
		setCrosshairColor(Color3.new(1,1,1))
		return
	end

	if not character then return end

	if not lockedTarget then
		lockedTarget = getNearestTarget()
		return
	end

	local humanoid = lockedTarget:FindFirstChildOfClass("Humanoid")
	local targetRoot = lockedTarget:FindFirstChild("HumanoidRootPart")

	if not humanoid or humanoid.Health <= 0 then
		lockedTarget = getNearestTarget()
		return
	end

	if not targetRoot then
		lockedTarget = getNearestTarget()
		return
	end

	local isPlayer = Players:GetPlayerFromCharacter(lockedTarget)

	if isPlayer then
		setCrosshairColor(Color3.fromRGB(255,0,0))
	else
		setCrosshairColor(Color3.fromRGB(0,255,0))
	end

	camera.CFrame = CFrame.new(
		camera.CFrame.Position,
		targetRoot.Position
	)

end)
