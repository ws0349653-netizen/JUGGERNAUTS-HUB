-- Otimização de gráficos
local function optimize(v)
    if not v or not v.Parent then return end

    if IsA(v, "BasePart") then
        local part = v
        part.Reflectance = 0
        if not isPlayerPart(part) then
            part.Material = Enum.Material.SmoothPlastic
        end
    end

    if EFFECTS_TO_DISABLE[v.ClassName] then
        v.Enabled = false
    end

    if not isPlayerPart(v) then
        if IsA(v, "Texture") then
            v.Transparency = 0.3
        elseif IsA(v, "Decal") then
            v.Transparency = 0.1
        end
    end
end

-- Aplicar otimização em todos os objetos
local allDescendants = game:GetDescendants()
local total = #allDescendants
local batchSize = 300

task.spawn(function()
    for i = 1, total, 1 do
        optimize(allDescendants[i])
        if i % batchSize == 0 then
            task.wait()
        end
    end
end)

game.DescendantAdded:Connect(function(v)
