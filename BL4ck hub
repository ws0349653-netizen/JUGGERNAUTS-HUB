            camera.Focus = CFrame.new(minhaRaiz.Position)
        end
    end)
end)

-- 📌 SISTEMA DE MIRA PARA HABILIDADES
local ConfiguracoesMira = {
    AlcanceMaximo = 120,
    PrevisaoMovimento = 0.25,
    IgnorarAliados = false,
    ParteParaMirar = "HumanoidRootPart"
}

local function PegarPosicaoAlvoHabilidade()
    local jogadorLocal = Players.LocalPlayer
    local personagemLocal = jogadorLocal.Character
    if not personagemLocal then return nil end

    local alvosValidos = {}

    -- Busca jogadores
    for _, jogador in ipairs(Players:GetPlayers()) do
        if jogador ~= jogadorLocal then
            if ConfiguracoesMira.IgnorarAliados and jogador.Team == jogadorLocal.Team then
                continue
            end

            local personagemAlvo = jogador.Character
            if personagemAlvo then
                local humAlvo = personagemAlvo:FindFirstChildOfClass("Humanoid")
                local parteAlvo = personagemAlvo:FindFirstChild(ConfiguracoesMira.ParteParaMirar)

                if humAlvo and parteAlvo and humAlvo.Health > 0 then
                    local distancia = (personagemLocal.HumanoidRootPart.Position - parteAlvo.Position).Magnitude
                    if distancia <= ConfiguracoesMira.AlcanceMaximo then
                        table.insert(alvosValidos, {
                            Posicao = parteAlvo.Position,
                            Velocidade = parteAlvo.Velocity
                        })
                    end
                end
            end
        end
    end

    -- Busca NPCs
    for _, npc in ipairs(workspace:GetChildren()) do
        if npc.Name == "Inimigos" or npc.Name == "NPCs" then
            for _, corpo in ipairs(npc:GetChildren()) do
                local humAlvo = corpo:FindFirstChildOfClass("Humanoid")
                local parteAlvo = corpo:FindFirstChild(ConfiguracoesMira.ParteParaMirar)

                if humAlvo and parteAlvo and humAlvo.Health > 0 then
                    local distancia = (personagemLocal.HumanoidRootPart.Position - parteAlvo.Position).Magnitude
                    if distancia <= ConfiguracoesMira.AlcanceMaximo then
                        table.insert(alvosValidos, {
                            Posicao = parteAlvo.Position,
                            Velocidade = parteAlvo.Velocity
                        })
                    end
                end
            end
        end
    end

    if #alvosValidos == 0 then return nil end
    local alvoMaisProximo = alvosValidos[1]
    return alvoMaisProximo.Posicao + (alvoMaisProximo.Velocidade * ConfiguracoesMira.PrevisaoMovimento)
end

