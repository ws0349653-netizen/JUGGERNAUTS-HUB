-- 🎯 SISTEMA COMPLETO DA TRAVA DE MIRA + 🔒 CADEADO AO LADO DO BOTÃO LOCK
-- 📌 EXATAMENTE COMO VOCÊ PEDIU: CADEADO ARRASTÁVEL AO LADO
-- ==============================================
-- Variáveis do sistema
local ZOOM_DISTANCE = 15
local lockEnabled = false
local lockedTarget = nil
local botaoSistemaTrava = nil -- Botão LOCK
local indicadorCadeado = nil -- Cadeado ao lado

-- 📌 ENCONTRA O ALVO MAIS PRÓXIMO DA MIRA
local function getNearestToCrosshair()
    if not character then return nil end
    local myRoot = character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local closest = nil
    local shortestDist = math.huge
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Health > 0 then
            local charAlvo = obj.Parent
            if charAlvo ~= character then
                local hrp = charAlvo:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local pos, visivel = camera:WorldToViewportPoint(hrp.Position)
                    if visivel then
                        local posTela = Vector2.new(pos.X, pos.Y)
                        local distanciaCentro = (posTela - center).Magnitude

                        if distanciaCentro < shortestDist then
                            shortestDist = distanciaCentro
                            closest = charAlvo
                        end
                    end
                end
            end
        end
    end
    return closest
end

-- 📌 SISTEMA DE TRAVA E CÂMERA
RunService.RenderStepped:Connect(function()
    pcall(function()
        if not lockEnabled or not lockedTarget then
            setCrosshairColor(Color3.new(1,1,1))
            return
        end
        if not character then return end

        local humAlvo = lockedTarget:FindFirstChildOfClass("Humanoid")
        local raizAlvo = lockedTarget:FindFirstChild("HumanoidRootPart")
        local minhaRaiz = character:FindFirstChild("HumanoidRootPart")

        if raizAlvo and minhaRaiz then
            local ehJogador = false
            for _, jogador in pairs(Players:GetPlayers()) do
                if jogador.Character == lockedTarget then
                    ehJogador = true
                    break
                end
            end

            -- Cor da mira conforme alvo
            if ehJogador then
                setCrosshairColor(Color3.fromRGB(255, 0, 0))
            else
                setCrosshairColor(Color3.fromRGB(0, 255, 0))
            end

            -- Movimento da câmera
            local angulo = CFrame.new(minhaRaiz.Position, raizAlvo.Position)
            local posCam = minhaRaiz.Position + angulo.LookVector * -ZOOM_DISTANCE + Vector3.new(0, 3, 0)
