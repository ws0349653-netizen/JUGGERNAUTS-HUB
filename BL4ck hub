-- Encontrar alvo mais próximo da mira
local function getNearestToCrosshair()
    if not character then return nil end
    local myRoot = character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local closest = nil
    local shortestDist = math.huge
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

    for _, humanoid in pairs(workspace:GetDescendants()) do
        if humanoid:IsA("Humanoid") and humanoid.Health > 0 then
            local char = humanoid.Parent
            if char ~= character then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local pos, visible = camera:WorldToViewportPoint(hrp.Position)
                    if visible then
                        local screenPos = Vector2.new(pos.X, pos.Y)
                        local distToCenter = (screenPos - center).Magnitude
                        
                        if distToCenter < shortestDist then
                            shortestDist = distToCenter
                            closest = char
                        end
                    end
                end
            end
        end
    end
    return closest
end

