local EFFECTS_TO_DISABLE = {
    ParticleEmitter = true, Trail = true, Beam = true, Fire = true, Smoke = true, Sparkles = true
}

local POST_PROCESS_EFFECTS = {
    BloomEffect = true, BlurEffect = true, ColorCorrectionEffect = true, SunRaysEffect = true, DepthOfFieldEffect = true
}

local function IsA(instance, className) return instance:IsA(className) end
local function FindFirstAncestorOfClass(instance, className) return instance:FindFirstAncestorOfClass(className) end
local function GetPlayerFromCharacter(model) return Players:GetPlayerFromCharacter(model) end
local function isPlayerPart(obj)
    local model = FindFirstAncestorOfClass(obj, "Model")
    return model and GetPlayerFromCharacter(model) ~= nil
end

local function optimize(v)
    pcall(function()
        if not v or not v.Parent then return end
        if IsA(v, "BasePart") then
            v.Reflectance = 0
            if not isPlayerPart(v) then v.Material = Enum.Material.SmoothPlastic end
        end
        if EFFECTS_TO_DISABLE[v.ClassName] then v.Enabled = false end
        if not isPlayerPart(v) then
            if IsA(v, "Texture") then v.Transparency = 0.3
            elseif IsA(v, "Decal") then v.Transparency = 0.1 end
        end
    end)
end

local allDescendants = game:GetDescendants()
local batchSize = 300
task.spawn(function()
    for i = 1, #allDescendants do
        optimize(allDescendants[i])
        if i % batchSize == 0 then task.wait() end
    end
end)

game.DescendantAdded:Connect(function(v) task.spawn(optimize, v) end)

