-- Funções auxiliares corrigidas
local function IsA(instance, className)
    return instance:IsA(className)
end

local function FindFirstAncestorOfClass(instance, className)
    return instance:FindFirstAncestorOfClass(className)
end

local function GetPlayerFromCharacter(model)
    return Players:GetPlayerFromCharacter(model)
end

local function isPlayerPart(obj)
    local model = FindFirstAncestorOfClass(obj, "Model")
    return model and GetPlayerFromCharacter(model) ~= nil
end

