-- ==============================================
MenuPequeno.InputBegan:Connect(function(input)
    if not menuLocked and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        menuExpandido = not menuExpandido
        if menuExpandido then
            MenuGrande.Visible = true
            TweenService:Create(MenuGrande, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Size = UDim2.new(0, 210, 0, 320)}):Play()
        else
            TweenService:Create(MenuGrande, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {Size = UDim2.new(0, 210, 0, 0)}):Play()
            -- Espera a animação terminar para esconder
            task.delay(0.25, function()
                if not menuExpandido then
                    MenuGrande.Visible = false
                end
            end)
        end
    end
end)

