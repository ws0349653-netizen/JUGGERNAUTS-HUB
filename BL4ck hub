            setCrosshairColor(Color3.fromRGB(0,255,0))
        end

        -- Move a câmera para seguir o alvo
        local angleCFrame = CFrame.new(myRoot.Position, targetRoot.Position)
        local cameraPos = myRoot.Position + angleCFrame.LookVector * -ZOOM_DISTANCE + Vector3.new(0, 3, 0)
