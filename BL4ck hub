local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

-- CONFIGURAÇÕES - AJUSTE COMO QUISER
local Configuracoes = {
    AlcanceMaximo = 120,       -- Distância máxima que a skill chega
    PrevisaoMovimento = 0.25,  -- Antecipa o movimento do alvo
    IgnorarAliados = false,    -- Mude para true se não quiser acertar os amigos
    ParteParaMirar = "HumanoidRootPart" -- Parte do corpo que vai ser alvo
}

-- FUNÇÃO QUE PEGA A POSIÇÃO CERTA PARA USAR A SKILL
local function PegarPosicaoAlvoSkill()
    local jogadorLocal = Players.LocalPlayer
    local personagemLocal = jogadorLocal.Character
    
    if not personagemLocal then return nil end

    local alvosValidos = {}

    -- PROCURA OUTROS JOGADORES
    for _, jogador in ipairs(Players:GetPlayers()) do
        if jogador ~= jogadorLocal then
            if Configuracoes.IgnorarAliados and jogador.Team == jogadorLocal.Team then
                continue
            end

            local personagemAlvo = jogador.Character
            if personagemAlvo then
                local humanoide = personagemAlvo:FindFirstChildOfClass("Humanoid")
                local parteAlvo = personagemAlvo:FindFirstChild(Configuracoes.ParteParaMirar)

                if humanoide and parteAlvo and humanoide.Health > 0 then
                    local distancia = (personagemLocal.HumanoidRootPart.Position - parteAlvo.Position).Magnitude
                    if distancia <= Configuracoes.AlcanceMaximo then
                        table.insert(alvosValidos, {
                            Posicao = parteAlvo.Position,
                            Velocidade = parteAlvo.Velocity
                        })
                    end
                end
            end
        end
    end

    -- PROCURA NPCS SE TIVER NO JOGO
    for _, npc in ipairs(Workspace:GetChildren()) do
        if npc.Name == "Inimigos" or npc.Name == "NPCs" then
            for _, corpo in ipairs(npc:GetChildren()) do
                local humanoide = corpo:FindFirstChildOfClass("Humanoid")
                local parteAlvo = corpo:FindFirstChild(Configuracoes.ParteParaMirar)

                if humanoide and parteAlvo and humanoide.Health > 0 then
                    local distancia = (personagemLocal.HumanoidRootPart.Position - parteAlvo.Position).Magnitude
                    if distancia <= Configuracoes.AlcanceMaximo then
                        table.insert(alvosValidos, {
                            Posicao = parteAlvo.Position,
                            Velocidade = parteAlvo.Velocity
                        })
                    end
                end
            end
        end
    end

    -- SE NÃO TEM ALVOS, RETORNA NADA
    if #alvosValidos == 0 then return nil end

    -- PEGA O ALVO MAIS PRÓXIMO E CALCULA A POSIÇÃO FINAL
    local alvoMaisProximo = alvosValidos[1]
    local posicaoFinal = alvoMaisProximo.Posicao + (alvoMaisProximo.Velocidade * Configuracoes.PrevisaoMovimento)

    return posicaoFinal
end
