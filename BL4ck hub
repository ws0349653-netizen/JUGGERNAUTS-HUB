-- 🔧 FUNÇÃO CRIAR ESP AGORA TOTALMENTE LIMPO: SEM FUNDO, SEM BORDA, SÓ TEXTO
local function criarESP()
    -- ❌ SEM QUADRO, SEM FUNDO, SEM NADA! SÓ O TEXTO DIRETO
    local textoESP = Instance.new("TextLabel")
    textoESP.BackgroundTransparency = 1 -- Totalmente transparente, nenhum fundo
    textoESP.BorderSizePixel = 0 -- Sem borda nenhuma
    textoESP.Font = Enum.Font.GothamBold -- Fonte limpa e bonita
    textoESP.TextSize = 13 -- Tamanho bom, não muito grande nem pequeno
    textoESP.TextStrokeTransparency = 0.6 -- Contorno leve para enxergar melhor sem poluir
    textoESP.TextWrapped = false
    textoESP.TextXAlignment = Enum.TextXAlignment.Center
    textoESP.ZIndex = 4
    textoESP.Size = UDim2.new(0, 200, 0, 25) -- Tamanho ajustado para caber tudo
    return textoESP
end

local espTabela = {}
Players.PlayerRemoving:Connect(function(plr)
    if espTabela[plr] then
        espTabela[plr]:Destroy()
        espTabela[plr] = nil
    end
end)

RunService.RenderStepped:Connect(function()
    pcall(function()
        if not _G.AtivarESP then
            for _, texto in pairs(espTabela) do
                texto.Visible = false
            end
            return
        end

        if not character then return end
        local minhaRaiz = character:FindFirstChild("HumanoidRootPart")
        if not minhaRaiz then return end

        for _, jogador in pairs(Players:GetPlayers()) do
            if jogador ~= player then
                local personagem = jogador.Character
                if not personagem then
                    if espTabela[jogador] then espTabela[jogador].Visible = false end
                    continue
                end

                local raizAlvo = personagem:FindFirstChild("HumanoidRootPart")
                local humAlvo = personagem:FindFirstChildOfClass("Humanoid")

                if raizAlvo and humAlvo and humAlvo.Health > 0 then
                    -- Cria o ESP se ainda não existir
                    if not espTabela[jogador] then
                        espTabela[jogador] = criarESP()
                        espTabela[jogador].Parent = gui
                    end

                    local distancia = math.floor((raizAlvo.Position - minhaRaiz.Position).Magnitude)
                    local posTela, visivel = camera:WorldToViewportPoint(raizAlvo.Position)

                    if visivel then
                        -- Calcula porcentagem e cor conforme a vida (IGUAL ANTES)
                        local porcentagemVida = math.floor((humAlvo.Health / humAlvo.MaxHealth) * 100)
                        local corVida = porcentagemVida >= 90 and Color3.fromRGB(46, 204, 113) -- Verde vivo
                            or porcentagemVida >= 70 and Color3.fromRGB(39, 174, 96) -- Verde claro
                            or porcentagemVida >= 50 and Color3.fromRGB(241, 196, 15) -- Amarelo
                            or porcentagemVida >= 25 and Color3.fromRGB(230, 126, 34) -- Laranja
                            or Color3.fromRGB(231, 76, 60) -- Vermelho perigo

                        -- 📝 MANTÉM TODAS AS INFORMAÇÕES: NOME, DISTÂNCIA E VIDA
                        espTabela[jogador].Text = string.format("%s | 📏 %dm | ❤️ %d%%", jogador.Name, distancia, porcentagemVida)
                        espTabela[jogador].TextColor3 = corVida
                        espTabela[jogador].Position = UDim2.new(0, posTela.X - 100, 0, posTela.Y - 45) -- Posição acima da cabeça
                        espTabela[jogador].Visible = true
                    else
                        espTabela[jogador].Visible = false
                    end
                else
                    if espTabela[jogador] then espTabela[jogador].Visible = false end
                end
            end
        end
    end)
end)

