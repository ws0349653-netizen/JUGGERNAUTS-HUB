-------------------------------------------------
-- PEGAR ALVO
-------------------------------------------------

local function getNearestTarget()
	if not character then return nil end
	local myRoot = character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end

	local closest = nil
	local shortestDist = math.huge
	local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

	for _,humanoid in pairs(workspace:GetDescendants()) do
		if humanoid:IsA("Humanoid") and humanoid.Health > 0 then
			local char = humanoid.Parent
			if char ~= character then
				local hrp = char:FindFirstChild("HumanoidRootPart")
				if hrp then
					local distance = (hrp.Position - myRoot.Position).Magnitude
					if distance <= LOCK_DISTANCE then
						local pos, visible = camera:WorldToViewportPoint(hrp.Position)
						if visible then
							local screenPos = Vector2.new(pos.X, pos.Y)
							local distToCenter = (screenPos - center).Magnitude
							if distToCenter < shortestDist then
								shortestDist = distToCenter
								closest = char
							end
						end
					end
				 end
			end
		end
	end
	return closest
end

-------------------------------------------------
-- SISTEMA LOCK
-------------------------------------------------

RunService.RenderStepped:Connect(function()
	if not lockEnabled then
		return
	end
	if not character then return end

	if not lockedTarget then
		lockedTarget = getNearestTarget()
		return
	end

	local humanoid = lockedTarget:FindFirstChildOfClass("Humanoid")
	local targetRoot = lockedTarget:FindFirstChild("HumanoidRootPart")
	local myRoot = character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not targetRoot or humanoid.Health <= 0 or not myRoot then
		lockedTarget = getNearestTarget()
		return
	end

	-- CORRETA
	local isPlayer = false
	for _,plr in pairs(Players:GetPlayers()) do
		if plr.Character == lockedTarget then
			isPlayer = true
			break
		end
	end

	if isPlayer then
		setCrosshairColor(Color3.fromRGB(255,0,0))
	else
		setCrosshairColor(Color3.fromRGB(0,255,0))
	end

	local angleCFrame = CFrame.new(myRoot.Position, targetRoot.Position)
	local cameraPos = myRoot.Position + angleCFrame.LookVector * -ZOOM_DISTANCE + Vector3.new(0, 3, 0)
	camera.CFrame = CFrame.new(cameraPos, targetRoot.Position)
	camera.Focus = CFrame.new(myRoot.Position)
end)
