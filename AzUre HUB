-------------------------------------------------
-- PEGAR ALVO
-------------------------------------------------

local function getNearestTarget()
	if not character then return nil end
	local myRoot = character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end

	local closest = nil
	local shortestDist = math.huge

	for _,plr in pairs(Players:GetPlayers()) do
		if plr ~= player then
			local char = plr.Character
			if char then
				local humanoid = char:FindFirstChildOfClass("Humanoid")
				local hrp = char:FindFirstChild("HumanoidRootPart")
				if humanoid and hrp and humanoid.Health > 0 then
					local distance = (hrp.Position - myRoot.Position).Magnitude
					if distance <= LOCK_DISTANCE and distance < shortestDist then
						shortestDist = distance
						closest = char
					end
				end
			end
		end
	end
	return closest
end

-------------------------------------------------
-- SISTEMA LOCK
-------------------------------------------------

RunService.RenderStepped:Connect(function()
	if not lockEnabled then
		setCrosshairColor(Color3.new(1,1,1))
		return
	end
	if not character then return end

	if not lockedTarget then
		lockedTarget = getNearestTarget()
		return
	end

	local humanoid = lockedTarget:FindFirstChildOfClass("Humanoid")
	local targetRoot = lockedTarget:FindFirstChild("HumanoidRootPart")

	if not humanoid or not targetRoot or humanoid.Health <= 0 then
		lockedTarget = getNearestTarget()
		return
	end

	setCrosshairColor(Color3.fromRGB(255,0,0))
	camera.CFrame = CFrame.new(camera.CFrame.Position, targetRoot.Position)
	if character:FindFirstChild("HumanoidRootPart") then
		camera.Focus = character.HumanoidRootPart.CFrame
	end
end)
