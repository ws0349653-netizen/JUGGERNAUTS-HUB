end

Players.PlayerRemoving:Connect(function(plr)
	if espTable[plr] then
		espTable[plr]:Destroy()
		espTable[plr] = nil
	end
end)

-- ✅ LOOP LEVE: SÓ ATUALIZA, NÃO CRIA DO ZERO
RunService.Heartbeat:Connect(function()
	if not character then return end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return end

	for _,plr in pairs(Players:GetPlayers()) do
		if plr ~= player then
			local char = plr.Character
			if not char then
				if espTable[plr] then espTable[plr].Visible = false end
				continue
			end
			local hrp = char:FindFirstChild("HumanoidRootPart")
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			if hrp and humanoid and humanoid.Health > 0 then
				local distance = (hrp.Position - root.Position).Magnitude
				local pos, visible = camera:WorldToViewportPoint(hrp.Position)
				if visible and distance <= ESP_DISTANCE then
					if not espTable[plr] then
						espTable[plr] = createESP()
					end
					local obj = espTable[plr]
					obj.Visible = true
					
					local healthPercent = math.floor((humanoid.Health / humanoid.MaxHealth) * 100)
					local healthColor
					if healthPercent >= 90 then healthColor = Color3.fromRGB(0,200,100)
					elseif healthPercent >= 75 then healthColor = Color3.fromRGB(100,255,100)
					elseif healthPercent >= 50 then healthColor = Color3.fromRGB(255,200,50)
					elseif healthPercent >= 20 then healthColor = Color3.fromRGB(255,255,100)
					else healthColor = Color3.fromRGB(255,80,80) end
					
					obj.TextColor3 = healthColor
					obj.Position = UDim2.new(0,pos.X-100,0,pos.Y-60)
					obj.Text = "➤ "..plr.Name.." | "..math.floor(distance).."m | "..healthPercent.."%"
				else
					if espTable[plr] then espTable[plr].Visible = false end
				end
			else
				if espTable[plr] then espTable[plr].Visible = false end
			end
		end
	end
end)

